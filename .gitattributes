# Hash-pinned legal texts (tests/test_cla_workflow.py): identical bytes on every OS.
.github/CLA-*.md text eol=lf
.github/CCLA-*.md text eol=lf
app/mobile/ios/VoiceStudio/Resources/NativeLicences/*.txt text eol=lf
app/mobile/android/app/src/main/assets/licenses/*.txt text eol=lf

# Hash- and byte-compared mobile contracts (tests/test_mobile_contract.py): the
# bundled model asset is verified by SHA-256 over its raw bytes, and the generated
# catalogue, token and design artifacts are compared byte-for-byte. Git's Windows
# default (core.autocrlf=true) rewrites an unpinned text file to CRLF on checkout,
# so identical content looks stale and the bundled asset fails its pin there only.
app/mobile/contract/tts/* text eol=lf
app/mobile/contract/openapi.json text eol=lf
app/mobile/contract/models.json text eol=lf
app/mobile/contract/design.json text eol=lf
app/mobile/contract/tokens.json text eol=lf
app/mobile/ios/VoiceStudioKit/Sources/VoiceStudioKit/Theme/Tokens.generated.swift text eol=lf
app/mobile/android/core/designsystem/src/main/kotlin/com/voicestudio/mobile/designsystem/Tokens.generated.kt text eol=lf

# Windows batch files break goto/labels with LF endings.
*.bat text eol=crlf

# Repository-only moderation tests contain copied scam commands. Keep them in
# Git checkouts/CI, but do not distribute attack examples in source archives.
/app/tests/test_scam_guard.py export-ignore

# Pinned upstream MP3 encoder; provenance and checksums are reviewed separately.
app/mobile/ios/VoiceStudioKit/Sources/VSNative/Lame/** text eol=lf linguist-vendored
app/mobile/native/ios/patches/*.patch text eol=lf

# Vendored wheels are hash-pinned in uv.lock: never rewrite line endings.
*.whl binary
